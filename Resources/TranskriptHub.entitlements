<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Outbound Network Access for Model Downloads & YouTube Audio Ingestion -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- User-Selected Files Read/Write for Custom Folder & Audio File Transcription -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Microphone Hardware Input Access for In-App Audio Recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    
    <!-- Hardened Runtime JIT & Memory Access for Whisper Metal / Local Execution -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
